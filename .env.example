# ---------------------------------------------------------------------------
# Discord Python Runner - example environment file
# Copy this file to `.env` and fill in the values for local development.
# On Render, set these in the service's "Environment" tab instead.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Bot token from the Discord Developer Portal (REQUIRED). Keep this secret.
DISCORD_TOKEN=

# Optional Discord webhook URL for alternative output delivery. Keep secret.
DISCORD_WEBHOOK_URL=

# Port the health server binds to. Render injects PORT automatically; this
# value is only used locally.
PORT=10000

# Detection behavior --------------------------------------------------------
# true  -> only explicit ```python / ```py blocks run (recommended default)
# false -> unmarked ``` ``` fenced blocks are also treated as Python
REQUIRE_PYTHON_CODE_BLOCK=true

# false -> run only the FIRST python block (default, never concatenates)
# true  -> join and run ALL python blocks in the message
EXECUTE_ALL_BLOCKS=false

# Limits --------------------------------------------------------------------
MAX_CODE_LENGTH=5000
MAX_EXECUTION_TIME=5
MAX_OUTPUT_LENGTH=8000
# Virtual-memory ceiling (MB) for each execution subprocess.
MAX_MEMORY_MB=256

# Concurrency ---------------------------------------------------------------
MAX_CONCURRENT_EXECUTIONS=1
# Extra requests allowed to wait for the slot before being rejected (0 = none).
MAX_QUEUE_SIZE=2

# Rate limiting -------------------------------------------------------------
MAX_EXECUTIONS_PER_USER_PER_MINUTE=5
MAX_GLOBAL_EXECUTIONS_PER_MINUTE=15
RATE_LIMIT_WINDOW_SECONDS=60

# Output delivery -----------------------------------------------------------
# bot | webhook | both
OUTPUT_MODE=bot

# Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
